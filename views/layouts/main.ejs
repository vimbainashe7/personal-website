<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Vimbainashe Tandire - Academic & Course Management Portal' %></title>
  
  <!-- SEO Meta Tags for Google Search -->
  <meta name="description" content="Official personal academic portal and course management workspace of Vimbainashe Tandire on gnostix.co.zw. Features smart course tracking, timetable schedules, and AI study assistant.">
  <meta name="keywords" content="Vimbainashe Tandire, Vimbainashe, Tandire, gnostix.co.zw, Course Manager, Academic Portal, Study Planner, Student Hub">
  <meta name="author" content="Vimbainashe Tandire">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://gnostix.co.zw<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://gnostix.co.zw<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Vimbainashe Tandire - Academic & Course Management Portal' %>">
  <meta property="og:description" content="Official personal academic portal and course management workspace of Vimbainashe Tandire on gnostix.co.zw.">
  <meta property="og:site_name" content="Vimbainashe Tandire">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Vimbainashe Tandire - Academic & Course Management Portal' %>">
  <meta name="twitter:description" content="Official personal academic portal and course management workspace of Vimbainashe Tandire on gnostix.co.zw.">

  <!-- Structured Data (JSON-LD) for Google Search Entity Recognition -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Vimbainashe Tandire",
    "url": "https://gnostix.co.zw",
    "jobTitle": "Student & Scholar",
    "description": "Official personal website and academic course management portal of Vimbainashe Tandire."
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Vimbainashe Tandire",
    "url": "https://gnostix.co.zw",
    "description": "Academic Course Management and Study Workspace for Vimbainashe Tandire"
  }
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- FullCalendar CSS -->
  <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/main.min.css" rel="stylesheet">

  <!-- Custom Styles -->
  <link rel="stylesheet" href="/css/style.css">

  <% if (user) { %>
    <meta id="currentUserIdMeta" data-user-id="<%= user.id %>">
  <% } %>
</head>
<body>
  <!-- Navbar Partial -->
  <%- include('../partials/navbar') %>

  <!-- Main Body Content -->
  <main class="flex-grow-1 py-4">
    <div class="container-xl">
      <%- body %>
    </div>
  </main>

  <!-- Footer Partial -->
  <%- include('../partials/footer') %>

  <!-- Floating Toast Notifications -->
  <%- include('../partials/toasts') %>

  <!-- Floating AI Assistant Drawer (Available for logged-in users) -->
  <% if (user) { %>
    <%- include('../partials/aiDrawer') %>
    <%- include('../partials/focusTimerModal') %>

    <!-- Floating AI Quick Trigger Button -->
    <button class="btn-floating-ai" id="openAiDrawerBtn" title="Ask Course AI" aria-label="Open AI Assistant">
      <i class="bi bi-stars"></i>
    </button>
  <% } %>

  <!-- Bootstrap 5 Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <!-- FullCalendar JS -->
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
  <!-- Canvas Confetti -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
  <!-- Socket.io -->
  <script src="/socket.io/socket.io.js"></script>

  <!-- App Scripts -->
  <script src="/js/main.js"></script>
  <script src="/js/calendar.js"></script>
  <script src="/js/ai-agent.js"></script>
  <script src="/js/notifications.js"></script>
  <script src="/js/timer.js"></script>
</body>
</html>
