<nav class="navbar navbar-expand-lg navbar-custom sticky-top">
  <div class="container-xl">
    <a class="navbar-brand navbar-brand-logo" href="/">
      <i class="bi bi-mortarboard-fill"></i> Vimbainashe Tandire
    </a>

    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <% if (user) { %>
        <!-- Main Navigation Links -->
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
          <li class="nav-item">
            <a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">
              <i class="bi bi-grid-1x2-fill me-1"></i> Dashboard
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath.startsWith('/courses') ? 'active' : '' %>" href="/courses">
              <i class="bi bi-journal-bookmark-fill me-1"></i> Courses
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath.startsWith('/timetable') ? 'active' : '' %>" href="/timetable">
              <i class="bi bi-calendar3 me-1"></i> Timetable
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath.startsWith('/gamification') ? 'active' : '' %>" href="/gamification">
              <i class="bi bi-trophy-fill me-1"></i> Achievements
            </a>
          </li>
        </ul>

        <!-- Right Side Quick Actions & User Profile -->
        <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
          <!-- Focus Timer Trigger -->
          <button class="btn btn-glass btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#focusTimerModal" title="Pomodoro Focus Timer">
            <i class="bi bi-stopwatch text-warning"></i> <span class="d-none d-md-inline">Focus</span>
          </button>

          <!-- Streak Counter Pill -->
          <a href="/gamification" class="stat-pill streak-badge text-decoration-none" title="Current Daily Study Streak">
            🔥 <span><%= (gamification && gamification.current_streak) || 0 %>d</span>
          </a>

          <!-- XP & Level Pill -->
          <a href="/gamification" class="stat-pill xp-badge text-decoration-none d-none d-sm-inline-flex" title="Level & Total XP">
            ⚡ <span>Lvl <%= (gamification && gamification.level) || 1 %></span>
            <span class="text-dim">|</span>
            <span class="xp-badge-val"><%= (gamification && gamification.xp) || 0 %> XP</span>
          </a>

          <!-- Notifications Dropdown -->
          <div class="dropdown">
            <a href="/notifications" class="btn btn-glass btn-sm position-relative px-2">
              <i class="bi bi-bell-fill"></i>
              <% if (unreadNotificationsCount > 0) { %>
                <span id="navNotificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                  <%= unreadNotificationsCount %>
                </span>
              <% } %>
            </a>
          </div>

          <!-- Dark / Light Theme Toggle -->
          <button id="themeToggleBtn" class="btn btn-glass btn-sm px-2" title="Toggle Theme">
            🌙
          </button>

          <!-- User Account Menu -->
          <div class="dropdown ms-1">
            <button class="btn btn-glass btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
              <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.8rem;">
                <%= user.name.charAt(0).toUpperCase() %>
              </div>
              <span class="d-none d-md-inline fw-semibold"><%= user.name %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 card-glass p-2">
              <li class="px-3 py-2">
                <p class="mb-0 fw-bold"><%= user.name %></p>
                <small class="text-muted"><%= user.email %></small>
              </li>
              <li><hr class="dropdown-divider my-1 border-secondary"></li>
              <li><a class="dropdown-item rounded py-2" href="/courses/new"><i class="bi bi-plus-circle me-2"></i> Add New Course</a></li>
              <li><a class="dropdown-item rounded py-2" href="/gamification"><i class="bi bi-award me-2"></i> My Badges & XP</a></li>
              <li><a class="dropdown-item rounded py-2" href="/notifications"><i class="bi bi-bell me-2"></i> Notifications</a></li>
              <li><hr class="dropdown-divider my-1 border-secondary"></li>
              <li>
                <form action="/auth/logout" method="POST" class="m-0">
                  <button type="submit" class="dropdown-item rounded py-2 text-danger">
                    <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                  </button>
                </form>
              </li>
            </ul>
          </div>
        </div>
      <% } else { %>
        <!-- Guest Links -->
        <div class="d-flex align-items-center gap-2 ms-auto">
          <button id="themeToggleBtn" class="btn btn-glass btn-sm px-2 me-2" title="Toggle Theme">
            🌙
          </button>
          <a href="/auth/login" class="btn btn-glass btn-sm px-3">Sign In</a>
          <a href="/auth/register" class="btn btn-primary-gradient btn-sm px-3">Get Started</a>
        </div>
      <% } %>
    </div>
  </div>
</nav>
